WEBSITE_HTTP_PORT=80
VITE_BASE_URL=/
VITE_API_BASE_URL=
# Required. Set this to the actual backend service URL in your deployment.
TRANSIT_HUB_UPSTREAM=http://transit-hub:8080
VITE_CURRENCY=CNY

# VM Podman Compose sub-path deployment without ingress rewrite:
# VITE_BASE_URL=/transit-hub

# Microservice ingress rewrites /transit-hub/... to /... before website container:
# VITE_BASE_URL=/transit-hub
# NGINX_BASE_URL=/
# TRANSIT_HUB_UPSTREAM=http://transit-hub-server:80
